    {
      "parameters": {
        "jsCode": "// Parsuj pełny raport GUS\nconst response = $input.first().json.data;\nconst prevData = $('Parsuj wynik szukania').first().json;\n\n// Funkcja pomocnicza do wyciągania wartości z XML\nfunction extractValue(xml, tagName) {\n  const regex = new RegExp(`<${tagName}>([^<]*)<\\/${tagName}>`);\n  const match = xml.match(regex);\n  return match ? match[1].trim() : '';\n}\n\n// Wyciągnij dane z raportu (różne pola dla osób prawnych i fizycznych)\nconst gusData = {\n  nazwa: extractValue(response, 'praw_nazwa') || extractValue(response, 'fiz_nazwa') || extractValue(response, 'Nazwa'),\n  ulica: extractValue(response, 'praw_adSiedzUlica_Nazwa') || extractValue(response, 'fiz_adSiedzUlica_Nazwa') || extractValue(response, 'Ulica'),\n  nrNieruchomosci: extractValue(response, 'praw_adSiedzNumerNieruchomosci') || extractValue(response, 'fiz_adSiedzNumerNieruchomosci') || extractValue(response, 'NrNieruchomosci'),\n  nrLokalu: extractValue(response, 'praw_adSiedzNumerLokalu') || extractValue(response, 'fiz_adSiedzNumerLokalu') || extractValue(response, 'NrLokalu'),\n  kodPocztowy: extractValue(response, 'praw_adSiedzKodPocztowy') || extractValue(response, 'fiz_adSiedzKodPocztowy') || extractValue(response, 'KodPocztowy'),\n  miejscowosc: extractValue(response, 'praw_adSiedzMiejscowosc_Nazwa') || extractValue(response, 'fiz_adSiedzMiejscowosc_Nazwa') || extractValue(response, 'Miejscowosc'),\n  regon: prevData.gusRegon,\n  krs: extractValue(response, 'praw_numerWRejestrzeEwidencji') || '',\n  pkd: extractValue(response, 'praw_pkdKod') || extractValue(response, 'fiz_pkdKod') || '',\n  formaPrawna: extractValue(response, 'praw_podstawowaFormaPrawna_Nazwa') || ''\n};\n\n// Zbuduj pełny adres\ngusData.adresPelny = [\n  gusData.ulica,\n  gusData.nrNieruchomosci + (gusData.nrLokalu ? '/' + gusData.nrLokalu : '')\n].filter(Boolean).join(' ');\n\nreturn [{\n  json: {\n    ...prevData,\n    gusData: gusData\n  }\n}];"
      },
