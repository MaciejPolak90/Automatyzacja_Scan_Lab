      ],
      "id": "01e55e08-3341-4a45-9526-a8ff01226f13",
      "name": "Parsuj raport GUS"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst gus = data.gusData;\n\nconst fields = {\n  TITLE: gus.nazwa,\n  UF_CRM_1757666334249: gus.nazwa,\n  UF_CRM_1769435935: gus.regon,\n  UF_CRM_1769435983: gus.krs,\n  UF_CRM_1769435766: 1386,\n  UF_CRM_1769435867: ''\n};\n\nif (gus.adresPelny) fields.ADDRESS = gus.adresPelny;\nif (gus.miejscowosc) fields.ADDRESS_CITY = gus.miejscowosc;\nif (gus.kodPocztowy) fields.ADDRESS_POSTAL_CODE = gus.kodPocztowy;\nif (gus.email) fields.EMAIL = [{ VALUE: gus.email, VALUE_TYPE: 'WORK' }];\nif (gus.wojewodztwoId) fields.UF_CRM_661903D5079E4 = gus.wojewodztwoId;\n\nreturn [{\n  json: {\n    ...data,\n    bitrixUpdateBody: JSON.stringify({\n      ID: String(data.result.ID),\n      fields: fields\n    })\n  }\n}];"
      },
