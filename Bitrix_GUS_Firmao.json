      "parameters": {
        "jsCode": "// Sprawdź czy klient z danym NIP istnieje w wynikach Firmao\nconst nip = $('Parsuj raport GUS').first().json.nipNormalized;\nconst customers = $input.first().json.data || [];\n\nconst found = customers.find(c => c.nipNumber === nip);\n\nreturn [{\n  json: {\n    customerExists: !!found,\n    customerId: found ? found.id : null,\n    customerLabel: found ? found.label : null\n  }\n}];"
