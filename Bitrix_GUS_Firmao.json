    {
      "parameters": {
        "jsCode": "// Wyciągnij SID z odpowiedzi SOAP\nconst response = $input.first().json.data;\nconst sidMatch = response.match(/<ZaslogujResult>([^<]+)<\\/ZalogujResult>/);\n\nif (!sidMatch || !sidMatch[1]) {\n  throw new Error('Nie udało się zalogować do GUS - brak SID w odpowiedzi');\n}\n\nconst sid = sidMatch[1];\n\nreturn [{\n  json: {\n    ...$('Waliduj NIP').first().json,\n    gusSid: sid\n  }\n}];"
      },
