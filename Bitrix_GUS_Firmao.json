      "parameters": {
        "jsCode": "// Wyciągnij SID z odpowiedzi JSON\nconst sid = $input.first().json.d;\n\nif (!sid) {\n  throw new Error('GUS login failed: ' + JSON.stringify($input.first().json));\n}\n\nreturn [{ json: { ...$('Waliduj NIP').first().json, gusSid: sid } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, -200],
      "id": "parse-gus-sid",
