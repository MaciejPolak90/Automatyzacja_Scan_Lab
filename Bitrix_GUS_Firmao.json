    {
      "parameters": {
        "jsCode": "// Normalizacja i walidacja NIP\nconst rawNip = $input.first().json.result.UF_CRM_661903D52335E || '';\n\n// 1. Normalizacja: usuń wszystko oprócz cyfr\nconst nip = rawNip.replace(/[^0-9]/g, '');\n\n// 2. Walidacja długości\nif (nip.length !== 10) {\n  return [{\n    json: {\n      ...$input.first().json,\n      nipNormalized: nip,\n      nipValid: false,\n      nipError: `NIP musi mieć 10 cyfr, podano: ${nip.length}`\n    }\n  }];\n}\n\n// 3. Walidacja checksum (wagi: 6,5,7,2,3,4,5,6,7)\nconst weights = [6, 5, 7, 2, 3, 4, 5, 6, 7];\nlet sum = 0;\nfor (let i = 0; i < 9; i++) {\n  sum += parseInt(nip[i]) * weights[i];\n}\nconst checksum = sum % 11;\nconst lastDigit = parseInt(nip[9]);\n\nif (checksum !== lastDigit) {\n  return [{\n    json: {\n      ...$input.first().json,\n      nipNormalized: nip,\n      nipValid: false,\n      nipError: `Nieprawidłowa suma kontrolna NIP`\n    }\n  }];\n}\n\n// NIP poprawny\nreturn [{\n  json: {\n    ...$input.first().json,\n    nipNormalized: nip,\n    nipValid: true,\n    nipError: null\n  }\n}];"
      },
