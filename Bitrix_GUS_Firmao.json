        "jsonBody": "={\n  \"ID\": \"{{ $json.result.ID }}\",\n  \"fields\": {\n    \"TITLE\": \"{{ $json.gusData.nazwa }}\",\n    \"UF_CRM_1757666334249\": \"{{ $json.gusData.nazwa }}\",\n    \"UF_CRM_1769435935\": \"{{ $json.gusData.regon }}\",\n    \"UF_CRM_1769435983\": \"{{ $json.gusData.krs }}\",\n    \"UF_CRM_1769435766\": 1386,\n    \"UF_CRM_1769435867\": \"\"\n    {{ $json.gusData.adresPelny ? ', \"ADDRESS\": \"' + $json.gusData.adresPelny + '\"' : '' }}\n    {{ $json.gusData.miejscowosc ? ', \"ADDRESS_CITY\": \"' + $json.gusData.miejscowosc + '\"' : '' }}\n    {{ $json.gusData.kodPocztowy ? ', \"ADDRESS_POSTAL_CODE\": \"' + $json.gusData.kodPocztowy + '\"' : '' }}\n    {{ $json.gusData.email ? ', \"EMAIL\": [{\"VALUE\": \"' + $json.gusData.email + '\", \"VALUE_TYPE\": \"WORK\"}]' : '' }}\n    {{ $json.gusData.wojewodztwoId ? ', \"UF_CRM_661903D5079E4\": ' + $json.gusData.wojewodztwoId : '' }}\n  }\n}",
