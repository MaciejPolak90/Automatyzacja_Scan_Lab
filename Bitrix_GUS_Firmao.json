    {
      "parameters": {
        "jsCode": "// Parsuj odpowiedź wyszukiwania GUS\nconst response = $input.first().json.data;\nconst prevData = $('Parsuj SID').first().json;\n\n// Wyciągnij REGON z odpowiedzi\nconst regonMatch = response.match(/<Regon>([^<]+)<\\/Regon>/);\nconst typMatch = response.match(/<Typ>([^<]+)<\\/Typ>/);\n\nif (!regonMatch || !regonMatch[1]) {\n  return [{\n    json: {\n      ...prevData,\n      gusFound: false,\n      gusError: 'Nie znaleziono firmy w GUS dla podanego NIP'\n    }\n  }];\n}\n\nconst regon = regonMatch[1];\nconst typ = typMatch ? typMatch[1] : 'P'; // P = osoba prawna, F = fizyczna\n\n// Określ nazwę raportu na podstawie typu i długości REGON\nlet raportName;\nif (typ === 'P') {\n  raportName = 'BIR11OsPrawna';\n} else if (typ === 'F') {\n  if (regon.length === 9) {\n    raportName = 'BIR11OsFizycznaDzworzytelnosc';\n  } else {\n    raportName = 'BIR11OsFizycznaDzialalnoscCeidg';\n  }\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    gusFound: true,\n    gusRegon: regon,\n    gusTyp: typ,\n    gusRaportName: raportName\n  }\n}];"
      },
