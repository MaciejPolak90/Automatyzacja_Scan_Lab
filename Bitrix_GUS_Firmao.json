    {
      "parameters": {
        "jsCode": "// Parsuj odpowiedź wyszukiwania GUS (JSON endpoint zwraca XML w polu 'd')\nconst response = $input.first().json.d || '';\nconst prevData = $('Parsuj SID').first().json;\n\n// Wyciągnij REGON z odpowiedzi\nconst regonMatch = response.match(/<Regon>([^<]+)<\\/Regon>/);\nconst typMatch = response.match(/<Typ>([^<]+)<\\/Typ>/);\nconst silosMatch = response.match(/<SilosID>([^<]+)<\\/SilosID>/);\n\nif (!regonMatch || !regonMatch[1]) {\n  return [{\n    json: {\n      ...prevData,\n      gusFound: false,\n      gusError: 'Nie znaleziono firmy w GUS dla podanego NIP'\n    }\n  }];\n}\n\nconst regon = regonMatch[1];\nconst typ = typMatch ? typMatch[1] : 'P'; // P = osoba prawna, F = fizyczna\nconst silosId = silosMatch ? silosMatch[1] : '';\n\n// Określ nazwę raportu na podstawie typu i SilosID\nlet raportName;\nif (typ === 'P') {\n  raportName = 'BIR11OsPrawna';\n} else if (typ === 'F') {\n  // SilosID dla osób fizycznych: 1=CEIDG, 2=rolnicza, 3=pozostała, 4=skreślona\n  if (silosId === '1') {\n    raportName = 'BIR11OsFizycznaDzialalnoscCeidg';\n  } else if (silosId === '2') {\n    raportName = 'BIR11OsFizycznaDzialalnoscRolnicza';\n  } else if (silosId === '3') {\n    raportName = 'BIR11OsFizycznaDzialalnoscPozostala';\n  } else if (silosId === '4') {\n    raportName = 'BIR11OsFizycznaDzialalnoscSkreslonaDo20141108';\n  } else {\n    raportName = 'BIR11OsFizycznaDzialalnoscCeidg'; // domyślnie CEIDG\n  }\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    gusFound: true,\n    gusRegon: regon,\n    gusTyp: typ,\n    gusSilosId: silosId,\n    gusRaportName: raportName\n  }\n}];"
      },
