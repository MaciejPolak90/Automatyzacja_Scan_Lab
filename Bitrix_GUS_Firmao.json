    {
      "parameters": {
        "jsCode": "// Parsuj pełny raport GUS (JSON endpoint zwraca XML w polu 'd')\nconst response = $input.first().json.d || '';\nconst prevData = $('Parsuj wynik szukania').first().json;\n\n// Funkcja pomocnicza do wyciągania wartości z XML\nfunction extractValue(xml, tagName) {\n  const regex = new RegExp(`<${tagName}>([^<]*)<\\/${tagName}>`);\n  const match = xml.match(regex);\n  return match ? match[1].trim() : '';\n}\n\n// Wyciągnij dane z raportu (różne pola dla osób prawnych i fizycznych)\nconst gusData = {\n  nazwa: extractValue(response, 'praw_nazwa') || extractValue(response, 'fiz_nazwa') || extractValue(response, 'Nazwa'),\n  ulica: extractValue(response, 'praw_adSiedzUlica_Nazwa') || extractValue(response, 'fiz_adSiedzUlica_Nazwa') || extractValue(response, 'Ulica'),\n  nrNieruchomosci: extractValue(response, 'praw_adSiedzNumerNieruchomosci') || extractValue(response, 'fiz_adSiedzNumerNieruchomosci') || extractValue(response, 'NrNieruchomosci'),\n  nrLokalu: extractValue(response, 'praw_adSiedzNumerLokalu') || extractValue(response, 'fiz_adSiedzNumerLokalu') || extractValue(response, 'NrLokalu'),\n  kodPocztowyRaw: extractValue(response, 'praw_adSiedzKodPocztowy') || extractValue(response, 'fiz_adSiedzKodPocztowy') || extractValue(response, 'KodPocztowy'),\n  miejscowosc: extractValue(response, 'praw_adSiedzMiejscowosc_Nazwa') || extractValue(response, 'fiz_adSiedzMiejscowosc_Nazwa') || extractValue(response, 'Miejscowosc'),\n  regon: prevData.gusRegon,\n  krs: extractValue(response, 'praw_numerWRejestrzeEwidencji') || '',\n  pkd: extractValue(response, 'praw_pkdKod') || extractValue(response, 'fiz_pkdKod') || '',\n  formaPrawna: extractValue(response, 'praw_podstawowaFormaPrawna_Nazwa') || '',\n  email: extractValue(response, 'praw_adresEmail') || extractValue(response, 'fiz_adresEmail') || '',\n  wojewodztwo: extractValue(response, 'praw_adSiedzWojewodztwo_Nazwa') || extractValue(response, 'fiz_adSiedzWojewodztwo_Nazwa') || ''\n};\n\n// Mapowanie województw na ID listy Bitrix\nconst wojewodztwaMap = {\n  'dolnośląskie': 224, 'kujawsko-pomorskie': 226, 'lubelskie': 228,\n  'lubuskie': 230, 'łódzkie': 232, 'małopolskie': 234, 'mazowieckie': 236,\n  'opolskie': 238, 'podkarpackie': 240, 'podlaskie': 242, 'pomorskie': 244,\n  'śląskie': 246, 'świętokrzyskie': 248, 'warmińsko-mazurskie': 250,\n  'wielkopolskie': 252, 'zachodniopomorskie': 254\n};\ngusData.wojewodztwoId = wojewodztwaMap[gusData.wojewodztwo.toLowerCase()] || null;\n\n// Formatuj kod pocztowy (12345 -> 12-345)\nconst rawCode = gusData.kodPocztowyRaw;\ngusData.kodPocztowy = rawCode && rawCode.length === 5 ? rawCode.slice(0, 2) + '-' + rawCode.slice(2) : rawCode;\n\n// Zbuduj pełny adres\ngusData.adresPelny = [\n  gusData.ulica,\n  gusData.nrNieruchomosci + (gusData.nrLokalu ? '/' + gusData.nrLokalu : '')\n].filter(Boolean).join(' ');\n\nreturn [{\n  json: {\n    ...prevData,\n    gusData: gusData\n  }\n}];"
      },
