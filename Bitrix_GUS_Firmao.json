    {
      "parameters": {
        "jsCode": "// Zbierz dane z Bitrix i przygotuj payload do aktualizacji klienta w Firmao\n// UWAGA: Firmao PUT wymaga notacji z kropka dla zagniezdzonych pol\n// np. 'customFields.custom5' zamiast {customFields: {custom5: ...}}\n// Telefony i emaile to tablice: 'phones', 'emails'\nconst bitrixData = $('Bitrix: Pobierz firmę (po GUS)').first().json.result;\nconst userResult = $input.first().json.result || [];\nconst user = Array.isArray(userResult) && userResult.length > 0 ? userResult[0] : {};\n\n// 1. Osoba odpowiedzialna (imie + nazwisko)\nconst userName = [user.NAME, user.LAST_NAME].filter(Boolean).join(' ');\n\n// 2. Skaner (mapowanie ID enum Bitrix na nazwy)\nconst skanerMap = {\n  '628': 'Cameo', '630': 'Medit i500', '632': 'Pro Smile',\n  '634': 'Sirona', '636': 'SKANER ODEBRANY', '638': 'WŁASNY SKANER',\n  '664': 'Rapid', '980': 'Upcera'\n};\nconst skanerRaw = bitrixData.UF_CRM_1713100433488;\nlet skanerValue = '';\nif (Array.isArray(skanerRaw)) {\n  skanerValue = skanerRaw.map(id => skanerMap[String(id)] || String(id)).join(', ');\n} else if (skanerRaw && skanerRaw !== false && skanerRaw !== 'false') {\n  skanerValue = skanerMap[String(skanerRaw)] || String(skanerRaw);\n}\n\n// 3. Adres z Bitrix\nconst street = bitrixData.ADDRESS || '';\nconst city = bitrixData.ADDRESS_CITY || '';\nconst postCode = bitrixData.ADDRESS_POSTAL_CODE || '';\n\n// 4. Telefony (Bitrix multi-field)\nconst phones = Array.isArray(bitrixData.PHONE)\n  ? bitrixData.PHONE.map(p => p.VALUE).filter(Boolean)\n  : [];\n\n// 5. Emaile (Bitrix multi-field)\nconst emails = Array.isArray(bitrixData.EMAIL)\n  ? bitrixData.EMAIL.map(e => e.VALUE).filter(Boolean)\n  : [];\n\n// Buduj obiekt aktualizacji z notacja kropkowa (wymagane przez Firmao PUT)\nconst update = {};\n\nif (userName) update['customFields.custom5'] = userName;\nif (skanerValue) update['customFields.custom6'] = skanerValue;\n\nif (street) update['officeAddress.street'] = street;\nif (city) update['officeAddress.city'] = city;\nif (postCode) update['officeAddress.postCode'] = postCode;\nif (street || city || postCode) update['officeAddress.country'] = 'Polska';\n\nif (phones.length > 0) update.phones = phones;\nif (emails.length > 0) update.emails = emails;\n\nreturn [{\n  json: {\n    firmaoUpdateBody: JSON.stringify(update),\n    hasUpdates: Object.keys(update).length > 0\n  }\n}];"
      },
